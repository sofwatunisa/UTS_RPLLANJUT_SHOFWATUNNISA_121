<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Proposal"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="PengajuanSkripsiProcess" name="Pengajuan Proposal Skripsi UIN" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Start_Pengajuan" name="Mahasiswa Submit Proposal">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Pengajuan" targetRef="Task_VerifikasiSekprodi" />
    <bpmn:userTask id="Task_VerifikasiSekprodi" name="Verifikasi Kelayakan oleh Sekprodi" camunda:candidateGroups="sekprodi">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_VerifikasiSekprodi" targetRef="Gateway_Layak" />
    <bpmn:exclusiveGateway id="Gateway_Layak" name="Apakah Layak?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Tidak" name="Tidak" sourceRef="Gateway_Layak" targetRef="Task_NotifRevisi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isLayak == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_NotifRevisi" name="Kirim Email Penolakan" camunda:delegateExpression="${emailRevisiService}">
      <bpmn:incoming>Flow_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_End1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Ditolak" name="Pengajuan Ditolak">
      <bpmn:incoming>Flow_End1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_End1" sourceRef="Task_NotifRevisi" targetRef="End_Ditolak" />
    <bpmn:sequenceFlow id="Flow_Ya" name="Ya" sourceRef="Gateway_Layak" targetRef="Task_ReviewDosen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isLayak == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_ReviewDosen" name="Pemeriksaan &amp; Kesediaan Dosen" camunda:candidateGroups="dosen">
      <bpmn:incoming>Flow_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ReviewDosen" targetRef="Task_ApproveKaprodi" />
    <bpmn:userTask id="Task_ApproveKaprodi" name="Persetujuan SK oleh Kaprodi" camunda:candidateGroups="kaprodi">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ApproveKaprodi" targetRef="End_Disetujui" />
    <bpmn:endEvent id="End_Disetujui" name="SK Pembimbing Terbit">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="PengajuanSkripsiProcess">
      <bpmndi:BPMNShape id="_BPMNShape_Start_Pengajuan" bpmnElement="Start_Pengajuan">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Task_VerifikasiSekprodi" bpmnElement="Task_VerifikasiSekprodi">
        <dc:Bounds x="250" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Gateway_Layak" bpmnElement="Gateway_Layak" isMarkerVisible="true">
        <dc:Bounds x="400" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Task_ReviewDosen" bpmnElement="Task_ReviewDosen">
        <dc:Bounds x="500" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Task_ApproveKaprodi" bpmnElement="Task_ApproveKaprodi">
        <dc:Bounds x="650" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_End_Disetujui" bpmnElement="End_Disetujui">
        <dc:Bounds x="800" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Task_NotifRevisi" bpmnElement="Task_NotifRevisi">
        <dc:Bounds x="500" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_End_Ditolak" bpmnElement="End_Ditolak">
        <dc:Bounds x="650" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="250" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="350" y="118" />
        <di:waypoint x="400" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ya_di" bpmnElement="Flow_Ya">
        <di:waypoint x="450" y="118" />
        <di:waypoint x="500" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="600" y="118" />
        <di:waypoint x="650" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="750" y="118" />
        <di:waypoint x="800" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Tidak_di" bpmnElement="Flow_Tidak">
        <di:waypoint x="425" y="143" />
        <di:waypoint x="425" y="240" />
        <di:waypoint x="500" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_End1_di" bpmnElement="Flow_End1">
        <di:waypoint x="600" y="240" />
        <di:waypoint x="650" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>